# ──────────────────────────────────────────────────────────────
#  Скопируй в .env и заполни. .env НЕ коммитим (см. .gitignore).
# ──────────────────────────────────────────────────────────────

# Postgres
POSTGRES_USER=seller
POSTGRES_PASSWORD=changeme
POSTGRES_DB=seller
# Внутри docker-compose host = "db". Для локального запуска без докера — "localhost".
DATABASE_URL=postgresql+asyncpg://seller:changeme@db:5432/seller

# Redis (кеш + очереди Celery на следующих этапах)
REDIS_URL=redis://redis:6379/0

# Telegram
# Токен бота из @BotFather. НИКОГДА не коммитить.
BOT_TOKEN=123456:CHANGE_ME
# Публичный HTTPS-URL фронта (Mini App). Локально — cloudflared tunnel, см. README.
WEBAPP_URL=https://example.trycloudflare.com

# Backend
# Адрес API, который дёргает бот (внутренняя сеть docker-compose).
BACKEND_INTERNAL_URL=http://backend:8000
# CORS: домен Mini App. Можно несколько через запятую.
CORS_ORIGINS=https://example.trycloudflare.com
# Секрет приложения (генерируй случайный, напр. `openssl rand -hex 32`).
SECRET_KEY=change_me_random_secret
# Окно валидности initData в секундах (защита от replay). 0 = не проверять возраст.
INITDATA_MAX_AGE_SECONDS=86400

# ── Слой парсинга (Этап 2) ────────────────────────────────────
# Прокси. Рекомендуемый режим — ротирующий шлюз (один endpoint, сам меняет IP):
PROXY_URL=
# Альтернатива/дополнение — список прокси через запятую:
# PROXY_LIST=http://user:pass@host1:port,http://user:pass@host2:port
PROXY_LIST=

# Капча (2captcha/rucaptcha-совместимый протокол).
# captcha_provider: twocaptcha | none
CAPTCHA_PROVIDER=twocaptcha
CAPTCHA_API_KEY=
# rucaptcha: https://rucaptcha.com
CAPTCHA_BASE_URL=https://2captcha.com

# Кеш результатов парсинга в Redis, сек (0 = выключить кеш).
PROVIDER_CACHE_TTL=3600
# Троттлинг запросов к одному хосту: мин. интервал и верхняя граница джиттера, сек.
THROTTLE_MIN_INTERVAL=1.5
THROTTLE_JITTER=1.0

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_NAV_TIMEOUT_MS=45000

# ── AI (Этап 10) ──────────────────────────────────────────────
# Провайдер LLM: claude | none. Слой абстрактный (адаптер можно сменить).
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8
LLM_MAX_TOKENS=2048
